{
    "name": "robertogallea/laravel-claude-hooks",
    "description": "Claude Code hooks as tested Artisan commands in your Laravel app.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "claude", "claude-code", "hooks", "ai", "agents"],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/process": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "laravel/boost": "Installs this package's skill for coding agents (^2.0)"
    },
    "autoload": {
        "psr-4": {
            "RobertoGallea\\ClaudeHooks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RobertoGallea\\ClaudeHooks\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RobertoGallea\\ClaudeHooks\\ClaudeHooksServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "lint": "pint --test",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
